MONGO_URI=your_mongodb_connection_string_here
CLIENT_URL=http://localhost:5173

# Email SMTP settings (for Nodemailer)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=you@example.com
EMAIL_PASS=your_email_password
EMAIL_FROM="NeuroTriq <no-reply@example.com>"

# Where to send contact emails (defaults to ADMIN_EMAIL if not set)
CONTACT_EMAIL=info@neurotriq.co.ke

# Admin credentials (simple email + password)
ADMIN_EMAIL=info@neurotriq.co.ke
ADMIN_PASS=change_this_password

# JWT secret
JWT_SECRET=replace_with_a_long_random_secret

PORT=5000
