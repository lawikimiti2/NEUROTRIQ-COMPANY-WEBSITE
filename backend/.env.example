CLIENT_URL=http://localhost:5173

# Email SMTP settings (for Nodemailer)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=you@example.com
EMAIL_PASS=your_email_password
EMAIL_FROM="NeuroTriq <no-reply@example.com>"

# Where to send contact emails (defaults to ADMIN_EMAIL if not set)
CONTACT_EMAIL=info@neurotriq.co.ke

# Admin API token for protected endpoints (GET /api/admin/contacts)
ADMIN_TOKEN=replace_with_a_long_random_token

# Admin dashboard login (POST /api/admin/login) and JWT signing
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=replace_with_a_strong_password
JWT_SECRET=replace_with_a_long_random_secret

PORT=5000
